{
  "name": "react-native-boilerplate",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "ci": "rm -rf node_modules && npm install",
    "start": "NODE_ENV=production npx expo start -c",
    "start:dev": "NODE_ENV=development npx expo start -c --tunnel",
    "android": "NODE_ENV=production npx expo start --android ",
    "android:dev": "NODE_ENV=development npx expo start --android",
    "ios": "NODE_ENV=production npx expo start --ios",
    "ios:dev": "NODE_ENV=development npx expo start --ios",
    "web": "NODE_ENV=production npx expo start --web",
    "web:dev": "NODE_ENV=development npx expo start --web",
    "doctor:dev": "EXPO_NO_DOTENV=1 dotenv -e .env.development -- npx expo-doctor",
    "format": "prettier --config .prettierrc src/**/*.{ts,tsx} --write",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "jest --verbose --passWithNoTests",
    "test:watch": "jest --verbose --passWithNoTests --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/metro-runtime": "5.0.4",
    "@gorhom/bottom-sheet": "^4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/drawer": "^6.6.15",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@reduxjs/toolkit": "^2.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "axios": "^1.7.7",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "^53.0.9",
    "expo-asset": "~11.1.5",
    "expo-camera": "~16.1.6",
    "expo-constants": "~17.1.6",
    "expo-crypto": "~14.1.4",
    "expo-dev-client": "~5.1.8",
    "expo-font": "~13.3.1",
    "expo-image": "~2.1.7",
    "expo-linear-gradient": "~14.1.4",
    "expo-location": "~18.1.4",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.12",
    "https": "^1.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-maps": "1.20.1",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.12.5",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-vision-camera": "^4.5.3",
    "react-native-web": "^0.20.0",
    "react-redux": "^9.1.2",
    "react-test-renderer": "19.0.0",
    "redux-logger": "^3.0.6",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.17",
    "@types/react": "~19.0.10",
    "@types/redux-logger": "^3.0.13",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "fs-extra": "^11.3.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "metro": "^0.82.3",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "private": true,
  "volta": {
    "node": "18.18.2"
  }
}
